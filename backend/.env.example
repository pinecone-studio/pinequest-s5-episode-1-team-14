# Copy to backend/.env for local development. Keep real credentials out of Git.
# Current backend entry point only logs this port; it does not open a listener.
PORT=8080

# Required only by: npm run test:gemini-mn --workspace=backend
GEMINI_API_KEY=

# Reserved for the future TTS integration; not read by current code.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional TTS model override for latency comparisons (default: eleven_v4).
ELEVENLABS_MODEL_ID=
# Optional: "gemini" plays Gemini's own voice and skips ElevenLabs entirely.
VOICE_MODE=
# Optional: "live" uses the Gemini Live model for listening. The default
# turn-based mode sends each caller utterance to a Flash model, which
# recognises Mongolian phone audio far better. Override the models if needed.
AI_MODE=
GEMINI_TURN_MODEL=
GEMINI_TURN_FALLBACK=

# Reserved for the future telephony integration; not read by current code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# "Call me back" on the landing page: Twilio dials the visitor from
# TWILIO_PHONE_NUMBER and fetches <PUBLIC_URL>/voice. On Railway the public
# domain is detected automatically; set PUBLIC_URL elsewhere (e.g. ngrok).
PUBLIC_URL=
# Optional cap on callbacks per hour (default 30).
CALLBACK_HOURLY_LIMIT=

# Optional: answer calls to a Mongolian IP-phone number directly over SIP
# (no Twilio, no call forwarding). The host must allow inbound UDP on SIP_PORT
# and on SIP_RTP_PORT_START upwards (two ports per concurrent call).
# SIP_SERVER is the operator's SIP domain; SIP_USER is the phone number.
SIP_SERVER=
SIP_USER=
SIP_PASSWORD=
# Defaults: 5060 and 10000. Set SIP_PUBLIC_IP only if auto-detection is wrong.
SIP_PORT=
SIP_RTP_PORT_START=
SIP_PUBLIC_IP=

# Required for checkAvailability() and createAppointment(); enable Calendar API
# and share the target calendar with this service account. Availability needs
# free/busy access; booking creation needs "Make changes to events" (writer).
GOOGLE_CALENDAR_CLIENT_EMAIL=
# Paste the service-account PEM key in quotes; literal \n escapes are supported.
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Shared secret for the PWA dashboard's read-only /api/* routes (calls, bookings,
# knowledge). Use the same value as BACKEND_API_TOKEN in pwa/.env.local. The
# routes answer 401 while this is empty.
DASHBOARD_API_TOKEN=
