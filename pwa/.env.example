# Opt in to synthetic calls, bookings, knowledge and analytics. Rebuild after changing this flag.
NEXT_PUBLIC_USE_MOCK_API=false

# Server-side only: where the dashboard reads calls, bookings and knowledge.
# BACKEND_API_TOKEN must equal DASHBOARD_API_TOKEN in backend/.env.
BACKEND_API_URL=http://localhost:8080
BACKEND_API_TOKEN=

# Optional: the phone number the landing page's "call to try" button dials,
# e.g. +97611112222. Leave empty to show a dashboard link instead. Set it in
# the deployment's environment, not in the repository.
NEXT_PUBLIC_DEMO_NUMBER=
